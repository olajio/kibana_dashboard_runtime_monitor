{
  "name": "dashboard_health_monitor",
  "expiration": "365d",
  "role_descriptors": {
    "dhm_collector": {
      "cluster": [
        "manage_index_templates",
        "manage_ilm"
      ],
      "indices": [
        {
          "names": [
            "dashboard-health-monitor"
          ],
          "privileges": [
            "create_doc",
            "auto_configure",
            "view_index_metadata"
          ]
        },
        {
          "names": [
            "cdm_*",
            "data_dictionary"
          ],
          "privileges": [
            "read",
            "view_index_metadata"
          ]
        }
      ],
      "remote_indices": [
        {
          "clusters": [
            "agency-dashboard*"
          ],
          "names": [
            "cdm_*"
          ],
          "privileges": [
            "read",
            "read_cross_cluster",
            "view_index_metadata"
          ]
        }
      ],
      "applications": [
        {
          "application": "kibana-.kibana",
          "privileges": [
            "feature_dashboard.read"
          ],
          "resources": [
            "space:fed2"
          ]
        }
      ]
    }
  }
}
